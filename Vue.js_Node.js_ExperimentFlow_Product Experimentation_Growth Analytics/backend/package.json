    "@prisma/client": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "ioredis": "^5.0.0",
