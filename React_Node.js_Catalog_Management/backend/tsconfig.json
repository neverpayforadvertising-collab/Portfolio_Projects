{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // CHANGED: added "jest" so test files typecheck (describe/it/expect globals)
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  // CHANGED: exclude tests from the production build output (dist/)
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/__tests__/**"]
}
